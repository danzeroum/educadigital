# ============================================================
# EDUCADIGITAL — Environment Variables
# Copie para .env e preencha os valores
# NUNCA commite o .env com valores reais
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://educadigital:educadigital@localhost:5432/educadigital
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth (gere com: openssl genrsa -out jwt_private.pem 2048) ──
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_WHISPER_MODEL=whisper-1
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# ── Storage (S3 / MinIO) ─────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=educadigital-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── External APIs ────────────────────────────────────────────
YOUTUBE_DATA_API_KEY=AIzaCHANGE_ME

# ── Celery Workers ───────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_SENTRY_DSN=

# ── Feature Flags ────────────────────────────────────────────
FEATURE_DIAGNOSTIC_ENABLED=true
FEATURE_TUTOR_STREAMING=true
FEATURE_RISK_PREDICTION=false
FEATURE_OFFLINE_COLLECTIVE=false
FEATURE_COMMUNITY_CONTENT=false
